# Placeholders only. Fill your own privately in Railway Variables.
# Do not paste this unmodified, expose secrets in screenshots, or commit real values.
TELEGRAM_API_ID=YOUR_API_ID
TELEGRAM_API_HASH=YOUR_32_CHARACTER_API_HASH
BOT_TOKEN=YOUR_CURRENT_BOTFATHER_TOKEN
MONGO_URI=YOUR_EXTERNAL_MONGODB_URI
OWNER_IDS=YOUR_PERSONAL_NUMERIC_TELEGRAM_USER_ID
SESSION_ENCRYPTION_KEY=YOUR_COMPLETE_ORIGINAL_OR_NEW_44_CHARACTER_FERNET_KEY
PUBLIC_BASE_URL=https://YOUR_GENERATED_APP_DOMAIN
PORT=8080
# If using PORT=8080, set the Networking domain Target Port to 8080.
# Optional:
MONGO_DATABASE=telepilot
# PUBLIC_DOMAIN is also supported if it was already set instead of PUBLIC_BASE_URL.
# Use /health/live as Railway deploy-time healthcheck; verify /health/ready after boot.

# Staff private-chat Phone/OTP/2FA + QR alternative (default):
LOGIN_MODE=chat

# Clean, editable smallcaps UI (defaults):
UI_STYLE=smallcaps
UI_EDIT_PANELS=true
UI_CLEAN_INPUTS=true
# UI_STYLE=plain is available for accessibility.

# Public Telegram username for the contact admin button (with or without @):
ADMIN_USERNAME=YourAdminUsername

# Global availability only; each user must opt in per saved channel:
AUTO_CALLS_ENABLED=true
# Auto pacing/safety limits and force-subscribe maximum live in config.json.

# Initial photo default; owner-panel Mongo preference takes precedence afterwards:
START_PHOTO_ENABLED=true

# Signed-in account pool capacity (1-200); overrides old limits.max_pool_accounts:
MAX_POOL_ACCOUNTS=200

# Optional large-roster budget (15-1800); not a provider/RTC capacity guarantee.
MANUAL_HEALTH_TIMEOUT_SECONDS=600
