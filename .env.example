# Generate these with python3 scripts/setup.py; do not paste real values into git.
TELEGRAM_API_ID=YOUR_API_ID
TELEGRAM_API_HASH=YOUR_32_CHARACTER_API_HASH
BOT_TOKEN=YOUR_BOTFATHER_TOKEN
SESSION_ENCRYPTION_KEY=GENERATED_BY_SETUP
MONGO_ROOT_PASSWORD=GENERATED_BY_SETUP
MONGO_APP_PASSWORD=GENERATED_BY_SETUP
MONGO_URI=mongodb://telepilot:GENERATED_APP_PASSWORD@mongo:27017/telepilot?authSource=telepilot
PUBLIC_DOMAIN=bot-login.example.com
TLS_EMAIL=you@example.com

# Staff private-chat Phone/OTP/2FA + QR alternative (default):
LOGIN_MODE=chat

# UI defaults live in external config.json for the stock VPS Compose file:
# ui_style="smallcaps", ui_edit_panels=true, ui_clean_inputs=true.
# Railway/direct Docker env overrides: UI_STYLE, UI_EDIT_PANELS, UI_CLEAN_INPUTS.
# Adding them to .env alone is not a Compose override unless you also pass them.

# Public Telegram username for the contact admin button (with or without @):
ADMIN_USERNAME=YourAdminUsername

# Global availability only; each user must opt in per saved channel:
AUTO_CALLS_ENABLED=true
# Auto pacing/safety limits and force-subscribe maximum live in config.json.

# Initial photo default; owner-panel Mongo preference takes precedence afterwards:
START_PHOTO_ENABLED=true

# Signed-in account pool capacity (1-200); overrides old limits.max_pool_accounts:
MAX_POOL_ACCOUNTS=200

# Recommended 8-vCPU / 64-GB profile (see docs/VPS_200.md):
# Profile deliberately uses this separate value even if old MAX_POOL_ACCOUNTS=100.
VPS_MAX_POOL_ACCOUNTS=200
MANUAL_HEALTH_TIMEOUT_SECONDS=1800
# Optional VPS passthrough; blank preserves nonblank private config.json values:
# OWNER_IDS=YOUR_ACTUAL_NUMERIC_OWNER_IDS
# MONGO_DATABASE=YOUR_ORIGINAL_APPLICATION_DATABASE
# Keep the ORIGINAL Compose project identity on upgrades; set one on fresh installs.
# COMPOSE_PROJECT_NAME=YOUR_STABLE_PROJECT_NAME
